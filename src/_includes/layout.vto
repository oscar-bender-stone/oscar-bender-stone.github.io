<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title || "Oscar Bender-Stone" }}</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>

<body>

  <header class="site-header">
    <div class="header-banner">
      <h1 class="site-title-heading">
        <a href="/" class="site-title-link">Oscar Bender-Stone</a>
      </h1>
      <div id="search" class="site-search"></div>
    </div>

    {{ comp.nav({ items: nav, currentUrl: url }) }}
  </header>

  <main data-pagefind-body>
    {{ if title && url !== "/" }}
      <h1>{{ title }}</h1>
    {{ /if }}

    {{ content }}
  </main>

  <footer class="site-footer">
    <p>Copyright &copy; {{ new Date().getFullYear() }} Oscar Bender-Stone.</p>
  </footer>

</body>

</html>
